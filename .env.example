# Single key is enough to run the app. Add GEMINI_API_KEYS (comma-separated)
# for automatic key rotation on quota errors -- optional, falls back to
# GEMINI_API_KEY alone if unset.
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_API_KEYS=your-gemini-api-key-here,optional-second-key,optional-third-key

GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
